---
import { formatDate, isoDate } from '../lib/content';

interface Props {
  posts: Array<{
    id: string;
    data: {
      title: string;
      description: string;
      pubDate: Date;
      draft: boolean;
      tags: string[];
    };
  }>;
}

const { posts } = Astro.props;
---

<ul class="post-list">
  {
    posts.map((post) => (
      <li>
        <h2>
          <a href={`/posts/${post.id}/`}>{post.data.title}</a>
          {post.data.draft && <span class="draft-dot" title="Draft">draft</span>}
        </h2>
        <p class="meta">
          <time datetime={isoDate(post.data.pubDate)}>
            {formatDate(post.data.pubDate)}
          </time>
        </p>
        <p class="post-list__description">{post.data.description}</p>
      </li>
    ))
  }
</ul>

<style>
  .post-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .post-list li + li {
    margin-top: 2rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }

  .post-list h2 {
    font-size: 1.1875rem;
    margin: 0 0 0.3rem;
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
  }

  .post-list h2 a {
    text-decoration: none;
    color: var(--text);
  }

  .post-list h2 a:hover {
    color: var(--link);
    text-decoration: underline;
  }

  .post-list .meta {
    margin: 0 0 0.4rem;
  }

  .post-list__description {
    margin: 0;
    color: var(--text-muted);
  }

  .draft-dot {
    font-family: var(--font-ui);
    font-size: 0.6875rem;
    font-weight: 650;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--accent);
    border: 1px dashed var(--accent);
    border-radius: 999px;
    padding: 0.05rem 0.45rem;
  }
</style>
